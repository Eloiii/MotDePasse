{
  "name": "mdp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc -b && vite build",
    "start": "node server/index.ts",
    "test": "node --test server/game.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "an-array-of-french-words": "^2.0.0",
    "vue": "^3.5.42",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24"
  }
}
